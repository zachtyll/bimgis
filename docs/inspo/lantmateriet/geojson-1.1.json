{
   "id": "#geojson-1.1.json",
   "$schema": "http://json-schema.org/draft-04/schema#",
   "title": "GeoJSON",
   "description": "Schema for GeoJSON 1.0 specification",
   "oneOf": [
      {
         "$ref": "#/definitions/geometry"
      },
      {
         "$ref": "#/definitions/feature"
      },
      {
         "$ref": "#/definitions/featurecollection"
      }
   ],
   "definitions": {
      "namedcrs": {
         "title": "GeoJSON Named CRS",
         "type": "object",
         "properties": {
            "type": {
               "type": "string",
               "enum": [
                  "name"
               ]
            },
            "properties": {
               "type": "object",
               "properties": {
                  "name": {
                     "type": "string"
                  }
               },
               "required": [
                  "name"
               ]
            }
         },
         "required": [
            "type",
            "properties"
         ]
      },
      "linkedcrs": {
         "title": "GeoJSON Linked CRS",
         "type": "object",
         "properties": {
            "type": {
               "type": "string",
               "enum": [
                  "link"
               ]
            },
            "properties": {
               "type": "object",
               "properties": {
                  "href": {
                     "type": "string",
                     "format": "uri"
                  },
                  "type": {
                     "type": "string"
                  }
               },
               "required": [
                  "href"
               ]
            }
         },
         "required": [
            "type",
            "properties"
         ]
      },
      "geojsonobject": {
         "description": "Base definition for GeoJSON objects",
         "type": "object",
         "properties": {
            "type": {
               "type": "string",
               "enum": [
                  "Point",
                  "LineString",
                  "Polygon",
                  "MultiPoint",
                  "MultiLineString",
                  "MultiPolygon",
                  "GeometryCollection",
                  "Feature",
                  "FeatureCollection"
               ]
            },
            "crs": {
               "oneOf": [
                  {
                     "type": "null"
                  },
                  {
                     "$ref": "#/definitions/crs"
                  }
               ]
            },
            "bbox": {
               "type": "array",
               "minItems": 4,
               "items": {
                  "type": "number"
               }
            }
         },
         "required": [
            "type"
         ]
      },
      "point": {
         "title": "GeoJSON Point",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "Point"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "minItems": 2,
                     "items": {
                        "type": "number"
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "linestring": {
         "title": "GeoJSON LineString",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "LineString"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "minItems": 2,
                     "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                           "type": "number"
                        }
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "polygon": {
         "title": "GeoJSON Polygon",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "Polygon"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "minItems": 1,
                     "items": {
                        "type": "array",
                        "minItems": 4,
                        "items": {
                           "type": "array",
                           "minItems": 2,
                           "items": {
                              "type": "number"
                           }
                        }
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "multipoint": {
         "title": "GeoJSON MultiPoint",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "MultiPoint"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                           "type": "number"
                        }
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "multilinestring": {
         "title": "GeoJSON MultiLineString",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "MultiLineString"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                           "type": "array",
                           "minItems": 2,
                           "items": {
                              "type": "number"
                           }
                        }
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "multipolygon": {
         "title": "GeoJSON MultiPolygon",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "MultiPolygon"
                     ]
                  },
                  "coordinates": {
                     "type": "array",
                     "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                           "type": "array",
                           "minItems": 4,
                           "items": {
                              "type": "array",
                              "minItems": 2,
                              "items": {
                                 "type": "number"
                              }
                           }
                        }
                     }
                  }
               },
               "required": [
                  "type",
                  "coordinates"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "geometrycollection": {
         "title": "GeoJSON GeometryCollection",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "GeometryCollection"
                     ]
                  },
                  "geometries": {
                     "type": "array",
                     "items": {
                        "$ref": "#/definitions/geometry"
                     }
                  }
               },
               "required": [
                  "type",
                  "geometries"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "feature": {
         "title": "GeoJSON Feature",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "Feature"
                     ]
                  },
                  "id": {
                     "oneOf": [
                        {
                           "type": "string"
                        },
                        {
                           "type": "number"
                        }
                     ]
                  },
                  "properties": {
                     "oneOf": [
                        {
                           "type": "null"
                        },
                        {
                           "type": "object"
                        }
                     ]
                  },
                  "geometry": {
                     "oneOf": [
                        {
                           "type": "null"
                        },
                        {
                           "$ref": "#/definitions/geometry"
                        }
                     ]
                  }
               },
               "required": [
                  "type",
                  "properties",
                  "geometry"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "featurecollection": {
         "title": "GeoJSON FeatureCollection",
         "type": "object",
         "allOf": [
            {
               "properties": {
                  "type": {
                     "type": "string",
                     "enum": [
                        "FeatureCollection"
                     ]
                  },
                  "features": {
                     "type": "array",
                     "items": {
                        "$ref": "#/definitions/feature"
                     }
                  }
               },
               "required": [
                  "type",
                  "features"
               ]
            },
            {
               "$ref": "#/definitions/geojsonobject"
            }
         ]
      },
      "geometry": {
         "title": "GeoJSON Geometry",
         "oneOf": [
            {
               "$ref": "#/definitions/multipoint"
            },
            {
               "$ref": "#/definitions/point"
            },
            {
               "$ref": "#/definitions/linestring"
            },
            {
               "$ref": "#/definitions/polygon"
            },
            {
               "$ref": "#/definitions/multilinestring"
            },
            {
               "$ref": "#/definitions/multipolygon"
            },
            {
               "$ref": "#/definitions/geometrycollection"
            }
         ]
      },
      "crs": {
         "title": "GeoJSON CRS",
         "oneOf": [
            {
               "$ref": "#/definitions/namedcrs"
            },
            {
               "$ref": "#/definitions/linkedcrs"
            }
         ]
      }
   }
}