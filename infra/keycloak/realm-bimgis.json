{
  "realm": "bimgis",
  "displayName": "bimgis",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "sv",
    "en"
  ],
  "defaultLocale": "sv",
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "Can contribute, reply and support (default for everyone who registers)"
      },
      {
        "name": "official",
        "description": "Municipal official: runs dialogues, synthesises, responds"
      },
      {
        "name": "moderator",
        "description": "Reviews reported and queued contributions"
      },
      {
        "name": "offline_access",
        "description": "Keycloak built-in: refresh tokens for offline use"
      },
      {
        "name": "uma_authorization",
        "description": "Keycloak built-in: user-managed access"
      },
      {
        "name": "default-roles-bimgis",
        "description": "Granted to every user. Makes everyone a citizen.",
        "composite": true,
        "composites": {
          "realm": [
            "citizen",
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-bimgis"
  },
  "clients": [
    {
      "clientId": "bimgis-web",
      "name": "bimgis web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Invånare",
      "email": "alice@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bimgis"
      ]
    },
    {
      "username": "olle",
      "firstName": "Olle",
      "lastName": "Planerare",
      "email": "olle@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bimgis",
        "official"
      ]
    },
    {
      "username": "mona",
      "firstName": "Mona",
      "lastName": "Moderator",
      "email": "mona@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bimgis",
        "moderator"
      ]
    }
  ]
}
